# AI 服务配置
# 默认使用模拟模式（无需 API Key）
REACT_APP_AI_MOCK_MODE=true

# 如需接入真实 AI API，请修改以下配置：
# REACT_APP_AI_MOCK_MODE=false
# REACT_APP_AI_API_URL=https://api.openai.com/v1/chat/completions
# REACT_APP_AI_API_KEY=your-api-key-here
# REACT_APP_AI_MODEL=gpt-4o-mini

# 其他支持的 API 示例：
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# 智谱 AI: https://open.bigmodel.cn/api/paas/v4/chat/completions
